%option noyywrap

%{
#include "parser.tab.h"

#include "../include/ast/ast_node.h"

%}

%%

[0-9]+  { 
            yylval.node = malloc(sizeof(struct AstNode));
            ast_node_init(yylval.node, AST_TYPE_DEC);
            return DEC;
        }

true|false  {
                yylval.node = malloc(sizeof(struct AstNode));
                ast_node_init(yylval.node, AST_TYPE_BOOL);
                return BOOL;
            }

\"[^\"\\]*(?:\\.[^\"\\]*)*\"    {
                                    yylval.node = malloc(sizeof(struct AstNode));
                                    ast_node_init(yylval.node, AST_TYPE_STR);
                                    return STR;
                                }

0[xX][0-9A-Fa-f]+   {
                        yylval.node = malloc(sizeof(struct AstNode));
                        ast_node_init(yylval.node, AST_TYPE_HEX);
                        return HEX;
                    }

0[bB][01]+  {
                yylval.node = malloc(sizeof(struct AstNode));
                ast_node_init(yylval.node, AST_TYPE_BITS);
                return BITS;
            }

<<EOF>> { 
            return 0;
        }

[ \t\n] { /* Ignore whitespaces */  }

%%
